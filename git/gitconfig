[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	excludesFile = ~/.gitignore

[pull]
	rebase = false

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = default
	algorithm = histogram

[branch]
	sort = -committerdate

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[include]
	path = ~/.gitconfig.local

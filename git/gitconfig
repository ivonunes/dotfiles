[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	excludesFile = ~/.gitignore

[pull]
	rebase = false

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[rerere]
	enabled = true

[include]
	path = ~/.gitconfig.local

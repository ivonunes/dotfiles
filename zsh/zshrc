export EDITOR="nvim"
export HOMEBREW_AUTO_UPDATE_SECS="86400"
export BAT_THEME="ansi"

export PATH="$HOME/.local/bin:$PATH"

HISTFILE="$HOME/.zhistory"
SAVEHIST=10000
HISTSIZE=10000

setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space  # a command typed with a space in front stays out of history
setopt hist_verify

alias vim="nvim"

# A coding agent's shell: no terminal on its output, or one that says who it is (Claude Code,
# Codex, OpenCode, Pi). Agents get the environment and plain tools, and none of the
# interactive layer below: the fancier stand-ins hang or take other options (eza's git column
# on big repos and slow drives; bat for cat), and their commands stay out of your history.
if [[ ! -t 1 || -n "$CLAUDECODE" || -n "$CODEX_SANDBOX" || -n "$OPENCODE" || -n "$AGENT" || -n "$PI_SESSION_ID" ]]; then
  agent_shell=1
fi

if [ -f "$HOME/.zshrc.local" ]; then
  . "$HOME/.zshrc.local"
fi

[[ -n "$agent_shell" ]] && return

# The interactive layer, for your own terminals.

if command -v bat >/dev/null 2>&1; then
  alias cat="bat --paging=never"
fi

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

if [ ! -d "$ZINIT_HOME/.git" ] && command -v git >/dev/null 2>&1; then
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

if [ -f "$ZINIT_HOME/zinit.zsh" ]; then
  source "$ZINIT_HOME/zinit.zsh"

  zinit snippet OMZL::git.zsh
  zinit snippet OMZL::directories.zsh
  zinit snippet OMZL::theme-and-appearance.zsh
  zinit snippet OMZL::async_prompt.zsh

  zinit snippet OMZP::git
  zinit snippet OMZP::brew
  zinit snippet OMZP::direnv

  zstyle ':omz:plugins:eza' 'dirs-first' yes
  zstyle ':omz:plugins:eza' 'git-status' yes
  zstyle ':omz:plugins:eza' 'header' yes
  zstyle ':omz:plugins:eza' 'icons' yes
  zinit snippet OMZP::eza
fi

autoload -Uz compinit
compinit

# fzf-tab after compinit, and before anything that wraps keyboard widgets.
if [ -f "$ZINIT_HOME/zinit.zsh" ]; then
  zinit light Aloxaf/fzf-tab
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# After fzf, so Ctrl-R is atuin's.
if command -v atuin >/dev/null 2>&1; then
  eval "$(atuin init zsh)"
fi

# Last: they wrap every widget defined before them.
if [ -f "$ZINIT_HOME/zinit.zsh" ]; then
  zinit light zsh-users/zsh-autosuggestions
  zinit light zsh-users/zsh-syntax-highlighting
fi
